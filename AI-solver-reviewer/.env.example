# Example .env file for production deployment
# Copy this to .env and fill in your actual values

# OpenRouter API Key
OPENROUTER_API_KEY=sk-or-v1-YOUR_API_KEY_HERE

# JWT Secret (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=GENERATE_YOUR_OWN_SECRET_KEY

# Database Password
POSTGRES_PASSWORD=YOUR_SECURE_PASSWORD_HERE

# GitHub Username (for frontend URL)
GITHUB_USERNAME=your-github-username

# Database settings (optional customization)
POSTGRES_USER=postgres
POSTGRES_DB=ai_reviewer_db
DATABASE_URL=postgresql://postgres:YOUR_SECURE_PASSWORD_HERE@localhost:5432/ai_reviewer_db
